# ============================================================
# SOURCE R2 ACCOUNT (Video source & File Explorer)
# ============================================================
SOURCE_R2_ENDPOINT=https://<source_account_id>.r2.cloudflarestorage.com
SOURCE_R2_ACCESS_KEY=your_source_r2_access_key
SOURCE_R2_SECRET_KEY=your_source_r2_secret_key
SOURCE_R2_BUCKET=your_source_r2_bucket

# ============================================================
# DESTINATION R2 ACCOUNT (Thumbnail upload to new_thumbnails)
# ============================================================
DEST_R2_ENDPOINT=https://<dest_account_id>.r2.cloudflarestorage.com
DEST_R2_ACCESS_KEY=your_dest_r2_access_key
DEST_R2_SECRET_KEY=your_dest_r2_secret_key
DEST_R2_BUCKET=your_dest_r2_bucket

# ============================================================
# SUPABASE CONFIGURATION (Replaced Cloudflare D1)
# ============================================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# ============================================================
# MONGODB CONFIGURATION (Duplicate prevention & metadata store)
# ============================================================
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=video_bot_db

# ============================================================
# UPLOADER ENGINES
# ============================================================
ZEROSTORAGE_API_KEY=your_zerostorage_api_key

# ============================================================
# APP SETTINGS
# ============================================================
PORT=8080
APP_URL=
